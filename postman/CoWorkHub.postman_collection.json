    "name": "CoWorkHub",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Reinicia la app antes de correr la coleccion (la base se recrea con datos de prueba). Corre primero 00 - Login."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "fechaConsulta",
      "value": "2030-06-03"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function f(dias, hora) {",
          "  var d = new Date(); d.setDate(d.getDate() + dias);",
          "  var p = function (n) { return String(n).padStart(2, '0'); };",
          "  return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + 'T' + hora;",
          "}",
          "pm.collectionVariables.set('d10_10', f(10, '10:00:00'));",
          "pm.collectionVariables.set('d10_12', f(10, '12:00:00'));",
          "pm.collectionVariables.set('d10_13', f(10, '13:00:00'));",
          "pm.collectionVariables.set('d10_14', f(10, '14:00:00'));",
          "pm.collectionVariables.set('d10_1445', f(10, '14:45:00'));",
          "pm.collectionVariables.set('d10_2130', f(10, '21:30:00'));",
          "pm.collectionVariables.set('d10_2230', f(10, '22:30:00'));",
          "pm.collectionVariables.set('d12_10', f(12, '10:00:00'));",
          "pm.collectionVariables.set('d12_11', f(12, '11:00:00'));"
        ]
      }
    }
  ],
